{
  "name": "@quotapilot/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "dotenv -e .env.migration -- prisma migrate dev",
    "db:migrate:create": "dotenv -e .env.migration -- prisma migrate dev --create-only",
    "db:deploy": "dotenv -e .env.migration -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.migration -- tsx --tsconfig tsconfig.json prisma/seed.ts",
    "test:isolation": "dotenv -e .env.local -e .env.migration -- vitest run -c prisma/vitest.isolation.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "6.19.3",
    "@quotapilot/domain": "workspace:*",
    "argon2": "0.45.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}
