# QuotaPilot environment template.
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# `.env` / `.env.*` are gitignored; only this file (`.env.example`) is tracked.
#
# Required variables (roles defined in docs/phase-1-slice-2.md §2):
#   NEXT_PUBLIC_APP_URL   — app base URL (links / redirect callback URLs)
#   DATABASE_URL          — runtime: NON-OWNER app role, NOBYPASSRLS, subject to RLS
#   APP_DATABASE_URL      — same app-role URL under a distinct name, isolation suite only
#   (in `.env.migration`, gitignored) DATABASE_URL + MIGRATION_DATABASE_URL — OWNER role,
#   migrations only, never at runtime.

# Public base URL of the app (links, redirect callback URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Runtime connection (NON-OWNER app role, subject to RLS) ──
# The app runtime connects as this role; it is NOBYPASSRLS, not the table
# owner, and has only DML grants. Created once as the local superuser by
# `apps/web/prisma/bootstrap-app-role.sql` (see docs/phase-1-slice-2.md).
DATABASE_URL=postgresql://quotapilot_app:QUOTAPILOT_APP_PASSWORD@localhost:5432/quotapilot?schema=public

# Same app-role URL under a distinct name for the RLS isolation suite, so a
# dotenv merge can never present the owner URL to an isolation test.
APP_DATABASE_URL=postgresql://quotapilot_app:QUOTAPILOT_APP_PASSWORD@localhost:5432/quotapilot?schema=public

# ── Migration connection (OWNER role — NEVER at runtime) ──
# Neither of these belongs in `.env.local`. Put them in a gitignored
# `.env.migration` that only `dotenv -e .env.migration -- prisma …` loads.
# `_DATABASE_URL` variant lets the isolation suite build a fixture/cleanup
# owner client without conflict.
#   DATABASE_URL=postgresql://quotapilot:OWNER_PASSWORD@localhost:5432/quotapilot?schema=public
#   MIGRATION_DATABASE_URL=postgresql://quotapilot:OWNER_PASSWORD@localhost:5432/quotapilot?schema=public