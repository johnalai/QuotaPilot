// QuotaPilot · Phase 1 production schema (Slice 2).
//
// Posture (architecture §7, docs/phase-1-slice-1.md):
//   - The app runtime connects as a non-owner app role subject to RLS
//     (NOBYPASSRLS). Ownership/migrations use a separate owner role.
//   - Tenant-scoped tables (`membership`, `invite`) carry `organization_id`
//     and an RLS policy on the null-safe claim predicate:
//       NULLIF(current_setting('request.jwt.claims', true), '')::jsonb ->> 'org_id'
//   - `organization` is NOT RLS-protected (service-layer authorization +
//     least-privilege grants); its CREATE/UPDATE/DELETE surface is the only
//     path and `plan_tier` is DB-defaulted and unwritable by the app role.
//   - Auth.js adapter models keep the exact field names @auth/prisma-adapter
//     reads (`userId`, `providerAccountId`, `sessionToken`, `refresh_token`, …)
//     while physical columns are normalized to snake_case via @map/@@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum PlanTier {
  trial
  pro
  enterprise
}

enum MembershipRole {
  owner
  admin
  member
}

enum MembershipStatus {
  active
  invited
  deactivated
}

// ── Tenant root (no RLS; service-layer authorization + role grants) ──────────

model Organization {
  id            String    @id @default(cuid(2))
  name          String
  slug          String    @unique
  planTier      PlanTier  @default(pro) @map("plan_tier")
  quotaCurrency String    @map("quota_currency")
  featureFlags  Json      @default("{}") @map("feature_flags")
  settings      Json      @default("{}")
  memberships   Membership[]
  invites       Invite[]
  quotaPlans    QuotaPlan[]
  customers     CustomerAccount[]
  deals         DealOpportunity[]
  forecastLines ForecastLine[]
  riskSignals   RiskSignal[]
  actionTasks   ActionTask[]
  forecastOverrides ForecastOverride[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("organization")
}

// ── Identity (global, not tenant-scoped; no RLS) ─────────────────────────────

model User {
  id             String       @id @default(cuid(2))
  name           String?
  email          String       @unique
  emailVerified  DateTime?    @map("email_verified")
  image          String?
  passwordHash   String?      @map("password_hash")
  timezone       String       @default("UTC")
  locale         String       @default("en")
  onboardedAt    DateTime?    @map("onboarded_at")
  memberships    Membership[]
  invitesCreated Invite[]     @relation("InviteCreator")
  dealsOwned    DealOpportunity[]
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("user")
}

// ── Tenant-scoped: user ↔ org (RLS backstop) ─────────────────────────────────

model Membership {
  id             String           @id @default(cuid(2))
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           MembershipRole
  status         MembershipStatus @default(active)
  joinedAt       DateTime?        @map("joined_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([status])
  @@map("membership")
}

// ── Tenant-scoped: new-member invitation (RLS backstop) ──────────────────────

model Invite {
  id             String         @id @default(cuid(2))
  organizationId String         @map("organization_id")
  email          String
  role           MembershipRole
  createdById    String         @map("created_by")
  expiresAt      DateTime       @map("expires_at")
  acceptedAt     DateTime?      @map("accepted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@index([createdById])
  @@map("invite")
}

// ── Auth.js adapter models ───────────────────────────────────────────────────
// Prisma field names are fixed by @auth/prisma-adapter (2.11.3); the @map/@@map
// only change PHYSICAL names to snake_case, never the generated client's
// property/delegate names.

model Account {
  id                String  @id @default(cuid(2))
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @map("session_token") @unique
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}
// ── Domain models (Phase 2a) ──────────────────────────────────────────────────
// All tenant-scoped: every table carries `organization_id` and is RLS-protected
// by the same null-safe claim predicate used for membership/invite.
// Computed fields (weightedAmount, risk scores, priority scores) are NOT
// stored — they are produced by packages/domain/rules/* on read.

enum QuotaPlanCurrency {
  USD
  EUR
  GBP
  CAD
  AUD
}

enum AccountStage {
  new
  active
  at_risk
  churned
}

enum OpportunityStage {
  prospecting
  qualified
  proposal
  negotiation
  won
  lost
}

enum RiskSignalKind {
  stale_opportunity
  pipeline_gap
  single_customer_concentration
  forecast_slippage
  deal_size_outlier
  win_rate_decline
}

enum RiskSignalSeverity {
  low
  medium
  high
  critical
}

enum ActionTaskKind {
  call
  demo
  prep
  review
  outreach
}

enum ActionTaskStatus {
  open
  done
  dismissed
}

model QuotaPlan {
  id                       String            @id @default(cuid(2))
  organizationId           String            @map("organization_id")
  quotaAmount              Int               @map("quota_amount")
  avgDealValue             Int               @map("avg_deal_value")
  winRate                  Float             @map("win_rate")
  opportunityConversionRate Float             @map("opportunity_conversion_rate")
  discoveryConversionRate  Float             @map("discovery_conversion_rate")
  firstMeetingConversionRate Float            @map("first_meeting_conversion_rate")
  pipelineCoverageTarget   Float             @map("pipeline_coverage_target")
  salesCycleMonths         Int               @map("sales_cycle_months")
  quotaCurrency            QuotaPlanCurrency @map("quota_currency")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
  @@index([organizationId])
  @@map("quota_plan")
}

model CustomerAccount {
  id            String        @id @default(cuid(2))
  organizationId String       @map("organization_id")
  name          String
  industry      String?
  segment       String?
  stage         AccountStage  @default(new)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities   DealOpportunity[]

  @@index([organizationId])
  @@index([stage])
  @@map("customer")
}

model DealOpportunity {
  id             String           @id @default(cuid(2))
  organizationId String           @map("organization_id")
  accountId      String           @map("account_id")
  name           String
  stage          OpportunityStage
  amount         Int
  closeDate      DateTime         @map("close_date")
  ownerId        String           @map("owner_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      CustomerAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  forecastLines ForecastLine[]
  riskSignals   RiskSignal[]
  actionTasks   ActionTask[]

  @@index([organizationId])
  @@index([accountId])
  @@index([ownerId])
  @@index([stage])
  @@index([closeDate])
  @@map("deal")
}

model ForecastLine {
  id             String      @id @default(cuid(2))
  organizationId String      @map("organization_id")
  opportunityId  String      @map("opportunity_id")
  month          String
  amount         Int
  confidence     Float
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  DealOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, opportunityId, month])
  @@index([organizationId])
  @@index([month])
  @@map("forecast_line")
}

model ForecastOverride {
  id            String   @id @default(cuid(2))
  organizationId String   @map("organization_id")
  month         String   // YYYY-MM
  committed     Int      // in minor units
  bestCase      Int      // in minor units
  pipeline      Int      // in minor units
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, month])
  @@index([organizationId])
  @@map("forecast_override")
}

model RiskSignal {
  id             String           @id @default(cuid(2))
  organizationId String           @map("organization_id")
  opportunityId  String?          @map("opportunity_id")
  kind           RiskSignalKind
  severity       RiskSignalSeverity
  message        String
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  DealOpportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([severity])
  @@map("risk_signal")
}

model ActionTask {
  id             String         @id @default(cuid(2))
  organizationId String         @map("organization_id")
  title          String
  kind           ActionTaskKind
  opportunityId  String?        @map("opportunity_id")
  dueDate        DateTime       @map("due_date")
  status         ActionTaskStatus @default(open)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  DealOpportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([dueDate])
  @@index([status])
  @@map("action_task")
}
